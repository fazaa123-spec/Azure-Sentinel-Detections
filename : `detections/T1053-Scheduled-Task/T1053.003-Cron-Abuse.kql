// Title: Linux Cron Job Abuse for Persistence
// MITRE ATT&CK: T1053.003 - Scheduled Task/Job: Cron
// Author: YourName
// Description: Detects attackers creating malicious cron jobs for persistence

// Hunt Query 1: Crontab Modification
SysmonEvent
| where EventID == 1
| where Image == "/usr/bin/crontab"
| where CommandLine has_any ("-e", "-l", "-r")
| where User != "root" and User != "crontab"
| extend timestamp = TimeGenerated, Host = Computer, User = Account
| extend MITRE_Tactic = "Persistence", MITRE_Technique_ID = "T1053.003"

// Hunt Query 2: Writing to Cron Directories
SysmonEvent
| where EventID == 11 // FileCreate
| where TargetFilename has_any ("/etc/cron.d/", "/etc/cron.daily/", "/etc/cron.hourly/", "/var/spool/cron/")
| where Image !in ("/usr/sbin/anacron", "/usr/bin/crontab")
| project TimeGenerated, Computer, Account, Image, TargetFilename
| extend MITRE_Tactic = "Persistence", MITRE_Technique_ID = "T1053.003"

// Alert Query: Suspicious Cron Job Execution
SysmonEvent
| where EventID == 1
| where ParentImage has "/usr/sbin/cron" or ParentImage has "/usr/sbin/crond"
| where Image has_any ("nc", "ncat", "bash -i", "python", "perl", "/dev/tcp/")
| project TimeGenerated, Computer, Account, ParentImage, Image, CommandLine
| extend Severity = "High"
